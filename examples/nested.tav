# Nested maps plus an array of inline maps — the only two ways structure
# appears in Tavra. `key = { ... }` nests the same way whether it's a
# top-level value or a field of another map; inline maps are needed inside
# arrays either way, since there's no per-element table syntax.

servers = [
    { name = "web-1", role = "frontend", port = 8080, healthy = true },
    { name = "web-2", role = "frontend", port = 8080, healthy = true },
    { name = "db-1", role = "database", port = 5432, healthy = false },
]

cluster = {
    name = "prod-east"
    region = "us-east-1"

    network = {
        vpc_id = "vpc-0123456789abcdef0"
        subnets = ["subnet-aaa", "subnet-bbb", "subnet-ccc"]
    }

    limits = {
        max_nodes = 50
        cpu_request = 0.5
        memory_request_mb = 512
    }
}
