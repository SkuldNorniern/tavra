# Every Tavra value type in one document.

# null and bool
nothing = null
enabled = true
disabled = false

# int: decimal, hex, octal, binary — all one logical type
dec = 42
neg = -17
big = 18446744073709551615  # u64::MAX, still just "int"
hex = 0xDEAD_BEEF
oct = 0o755
bin = 0b1010

# float: decimal, exponent, special values
pi_ish = 3.14159
small = 1e-3
huge = -2.5e10
infinite = inf
neg_infinite = -inf
not_a_number = nan

# string: basic (with escapes), raw, and multi-line
greeting = "hello\nworld"
path = 'C:\Users\example\no\escapes'
poem = """
Roses are red,
Violets are blue.
"""

# bytes: hex form (short) and base64 form (long) - a real type, not a
# base64 string you have to remember to decode on the other end
short_bytes = b"deadbeef"
long_bytes = b64"VGF2cmEgaXMgYSBkYXRhIGZvcm1hdCB3aXRoIGEgc2VjdXJlIGJpbmFyeSBjb3Jl"

# datetime: all four kinds
offset_dt = 2026-07-12T10:30:00+09:00
local_dt = 2026-07-12T10:30:00
just_date = 2026-07-12
just_time = 10:30:00

# array: homogeneous and mixed. Entries can be comma-separated on one line,
# newline-separated with no commas at all, or a trailing-comma block —
# all three are the same grammar.
numbers = [1, 2, 3]
mixed = [1, "two", 3.0, true, null]
nested_array = [
    [1, 2]
    [3, 4]
]

# inline map — this is the only nesting construct in the language, whether
# it's a one-liner like this or a multi-line block like the ones above.
point = { x = 1, y = 2 }

also_a_map = {
    this_is_a_map_too = true
}
